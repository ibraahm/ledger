{
  "name": "ledger",
  "version": "2.0.0",
  "description": "Encrypted private memory for personal and professional learning, growth, goals, tasks and relationships.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "init": "tsx src/init.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prepare:production": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "start:production": "node dist/server.js",
    "export": "tsx src/export.ts",
    "reset-password": "npm run build --silent && node dist/reset-password.js",
    "test": "npm run test:run",
    "test:run": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
