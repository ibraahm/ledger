# Run `npm run init` to generate these. Do not hand-write MASTER_KEY.
MASTER_KEY=
SESSION_SECRET=
CALENDAR_FEED_TOKEN=
PASSWORD_HASH=

OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Optional routing. Leave unset to use OLLAMA_MODEL for both paths.
# OLLAMA_FAST_MODEL=gpt-oss:20b
# OLLAMA_REVIEW_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_RETRIES=2

# Embedded Postgres by default; set DATABASE_URL to move to a server.
DATA_DIR=./data
# Public HTTPS origin used by Apple Calendar subscriptions.
# PUBLIC_URL=https://ledger.example.com
# DATABASE_URL=postgres://user:pass@host:5432/ledger

EXPORT_DIR=./export
BACKUP_DIR=./backups
BACKUP_RETENTION=14
OWNER_NAME=you
PORT=4321
# Keep Ledger private behind the HTTPS reverse proxy.
BIND_HOST=127.0.0.1

# Default for live prayer-time lookups. Method 2 is ISNA.
# PRAYER_LATITUDE=33.8082
# PRAYER_LONGITUDE=-84.1702
# PRAYER_METHOD=2
